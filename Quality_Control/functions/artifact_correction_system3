function plot_trace_selection()
    global ArtifactData
    
    figure(ArtifactData.selection_fig);
    
    % Clear previous plots but keep controls
    children = get(ArtifactData.selection_fig, 'Children');
    for i = 1:length(children)
        if strcmp(get(children(i), 'Type'), 'axes')
            delete(children(i));
        end
    end
    
    % Calculate current window
    frame_start = ArtifactData.current_start_frame;
    frame_end = min(frame_start + ArtifactData.window_size - 1, ArtifactData.total_frames);
    
    % Update frame info
    frame_info_handle = findobj(ArtifactData.selection_fig, 'Tag', 'FrameInfo');
    set(frame_info_handle, 'String', sprintf('Frames %d-%d of %d', frame_start, frame_end, ArtifactData.total_frames));
    
    % Create subplots
    % Create subplots with more room at bottom for controls
    hsp(1) = subplot(1,2,1);
    hsp(2) = subplot(1,2,2);
    set(hsp(1),'Position',[0.1300 0.2000 0.3347 0.7150]);  % Moved up from 0.1500
    set(hsp(2),'Position',[0.5703 0.2000 0.3347 0.7150]);  % Moved up from 0.1500
    time_sec = (frame_start-1:frame_end-1)/ArtifactData.sampling_rate;
    half_areas = ceil(ArtifactData.num_areas / 2);
    deltaF = 0.05;
    
    % Store trace positions for click detection
    ArtifactData.trace_positions = zeros(ArtifactData.num_areas, 2); % [subplot, y_offset]
    
    % Plot first half of areas
    subplot(hsp(1))
    set(gca,'color','w')
    for i = 1:half_areas
        hold on
        if i == 1
            plot([max(time_sec)-4, max(time_sec)-4], [0, deltaF], 'k', 'LineWidth', 2)
            text(max(time_sec)-3, deltaF/2, sprintf('%.2f', deltaF), 'FontSize', 10)
        end
        
        y_offset = -i*deltaF;
        plot(time_sec, ArtifactData.corrected_frames(i, frame_start:frame_end) + y_offset, 'b', 'LineWidth', 2)
        
        % Store position for click detection
        ArtifactData.trace_positions(i, :) = [1, y_offset];
    end
    
    ytick_pos = [-deltaF*half_areas:deltaF:0];
    ytick_labels = [fliplr(ArtifactData.ID(1:half_areas)), {'\DeltaF/F'}];
    set(gca, 'Ytick', ytick_pos, 'YtickLabel', ytick_labels)
    xlim([min(time_sec) max(time_sec)])
    xlabel('Time (s)')
    title('First Half of Brain Areas')
    
    % Plot second half of areas
    subplot(hsp(2))
    set(gca,'color','w')
    remaining_areas = ArtifactData.num_areas - half_areas;
    for i = 1:remaining_areas
        hold on
        area_idx = half_areas + i;
        if i == 1
            plot([max(time_sec)-4, max(time_sec)-4], [0, deltaF], 'k', 'LineWidth', 2)
            text(max(time_sec)-3, deltaF/2, sprintf('%.2f', deltaF), 'FontSize', 10)
        end
        
        y_offset = -i*deltaF;
        plot(time_sec, ArtifactData.corrected_frames(area_idx, frame_start:frame_end) + y_offset, 'b', 'LineWidth', 2)
        
        % Store position for click detection
        ArtifactData.trace_positions(area_idx, :) = [2, y_offset];
    end
    
    ytick_pos = [-deltaF*remaining_areas:deltaF:0];
    ytick_labels = [fliplr(ArtifactData.ID(half_areas+1:ArtifactData.num_areas)), {'\DeltaF/F'}];
