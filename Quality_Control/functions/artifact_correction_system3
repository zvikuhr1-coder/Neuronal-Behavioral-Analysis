function interpolated_data = interpolate_data(data, start_frame, end_frame)
    % Interpolate data between start_frame and end_frame
    % Uses linear interpolation between the points just before and after the range
    
    % Find valid points before and after the range for interpolation
    before_idx = start_frame - 1;
    after_idx = end_frame + 1;
    
    % Find the nearest valid points if the immediate neighbors are NaN
    while before_idx > 1 && (isnan(data(before_idx)) || isinf(data(before_idx)))
        before_idx = before_idx - 1;
    end
    
    while after_idx <= length(data) && (isnan(data(after_idx)) || isinf(data(after_idx)))
        after_idx = after_idx + 1;
    end
    
    % Perform interpolation if we have valid boundary points
    if before_idx >= 1 && after_idx <= length(data) && ...
       ~isnan(data(before_idx)) && ~isnan(data(after_idx)) && ...
       ~isinf(data(before_idx)) && ~isinf(data(after_idx))
        
        % Linear interpolation
        x1 = before_idx;
        x2 = after_idx;
        y1 = data(before_idx);
        y2 = data(after_idx);
        
        % Create interpolated values for the range
        interpolated_values = y1 + (y2 - y1) * ((start_frame:end_frame) - x1) / (x2 - x1);
        
    else
        % If we can't find valid boundary points, use the mean of the entire trace
        valid_data = data(~isnan(data) & ~isinf(data));
        if ~isempty(valid_data)
            mean_value = mean(valid_data);
            interpolated_values = repmat(mean_value, 1, end_frame - start_frame + 1);
        else
            % If no valid data exists, set to zero
            interpolated_values = zeros(1, end_frame - start_frame + 1);
        end
    end
    
    % Return only the interpolated values for the specified range
    interpolated_data = interpolated_values;
end
