function scroll_callback(~, eventdata)
    global ArtifactData
    
    if ArtifactData.step ~= 2, return; end
    
    % Scroll through frames
    scroll_direction = eventdata.VerticalScrollCount;
    
    if scroll_direction < 0
        % Scroll up - previous frames
        ArtifactData.current_start_frame = max(1, ArtifactData.current_start_frame - ArtifactData.window_size);
    else
        % Scroll down - next frames
        ArtifactData.current_start_frame = min(ArtifactData.total_frames - ArtifactData.window_size + 1, ...
            ArtifactData.current_start_frame + ArtifactData.window_size);
    end
    
    plot_trace_selection();
end

function prev_window_callback(~, ~)
    global ArtifactData
    
    ArtifactData.current_start_frame = max(1, ArtifactData.current_start_frame - ArtifactData.window_size);
    plot_trace_selection();
end

function next_window_callback(~, ~)
    global ArtifactData
    
    ArtifactData.current_start_frame = min(ArtifactData.total_frames - ArtifactData.window_size + 1, ...
        ArtifactData.current_start_frame + ArtifactData.window_size);
    plot_trace_selection();
end

function trace_click_callback(~, ~)
    global ArtifactData
    
    if ArtifactData.step ~= 2, return; end
    
    % Get click position
    click_pos = get(gca, 'CurrentPoint');
    click_y = click_pos(1, 2);
    
    % Get all subplot handles
    all_axes = findall(ArtifactData.selection_fig, 'Type', 'axes');
    current_axes = gca;
    
    % Determine which subplot was clicked by comparing handles
    subplot_num = 0;
    for i = 1:length(all_axes)
        if all_axes(i) == current_axes
            % Get the position to determine if it's left (1) or right (2)
            pos = get(current_axes, 'Position');
            if pos(1) < 0.4  % Left subplot has x-position < 0.4
                subplot_num = 1;
            else  % Right subplot
                subplot_num = 2;
            end
            break;
        end
    end
    
    if subplot_num == 0
        return; % Click not on a valid subplot
    end
    
    % Find closest trace
    min_distance = inf;
    selected_area = 0;
    
    for i = 1:ArtifactData.num_areas
        if ArtifactData.trace_positions(i, 1) == subplot_num
            trace_y = ArtifactData.trace_positions(i, 2);
            distance = abs(click_y - trace_y);
            
            if distance < min_distance && distance < 0.05 % Increased sensitivity
                min_distance = distance;
                selected_area = i;
            end
        end
    end
    
    if selected_area > 0
        fprintf('Selected area: %s (ID: %d) from subplot %d\n', ArtifactData.ID{selected_area}, selected_area, subplot_num);
        ArtifactData.selected_area = selected_area;
        
        % Move to step 3
        ArtifactData.step = 3;
        close(ArtifactData.selection_fig);
        show_trace_editing();
    else
        fprintf('No trace selected. Click closer to a trace line.\n');
    end
end

