function mouse_stats = calculate_mouse_statistics(MOUSE_DATA, current_mouse_name, ID)
    % Calculate statistics for the current mouse across all sessions
    mouse_stats = struct();
    mouse_stats.use_defaults = true;
    
    try
        % Find sessions for this mouse
        mouse_sessions = {};
        session_names = fieldnames(MOUSE_DATA);
        
        for i = 1:length(session_names)
            if contains(session_names{i}, current_mouse_name)
                mouse_sessions{end+1} = session_names{i};
            end
        end
        
        if isempty(mouse_sessions)
            fprintf('No sessions found for mouse %s, using default statistics\n', current_mouse_name);
            return;
        end
        
        % Collect all frame data for this mouse
        all_frames = [];
        for i = 1:length(mouse_sessions)
            session_name = mouse_sessions{i};
            if isfield(MOUSE_DATA.(session_name), 'frames')
                frames_data = MOUSE_DATA.(session_name).frames;
                if ~isempty(frames_data)
                    all_frames = [all_frames, frames_data];
                end
            end
        end
        
        if ~isempty(all_frames)
            num_areas = min(size(all_frames, 1), length(ID));
            mouse_stats.frames_std = zeros(num_areas, 1);
            mouse_stats.frames_median = zeros(num_areas, 1);
            
            for area = 1:num_areas
                area_data = all_frames(area, :);
                clean_data = area_data(~isnan(area_data) & ~isinf(area_data));
                
                if length(clean_data) > 100
                    mouse_stats.frames_std(area) = std(clean_data);
                    mouse_stats.frames_median(area) = median(clean_data);
                else
                    mouse_stats.frames_std(area) = 1;
                    mouse_stats.frames_median(area) = 0;
                end
            end
            
            mouse_stats.use_defaults = false;
            fprintf('Calculated statistics for mouse %s from %d sessions\n', current_mouse_name, length(mouse_sessions));
        end
        
    catch ME
        fprintf('Error calculating statistics for mouse %s: %s\n', current_mouse_name, ME.message);
        fprintf('Using default statistics\n');
    end
end
