function plot_trace_editing()
    global ArtifactData
    
    figure(ArtifactData.edit_fig);
    
    % Clear previous plots but keep controls
    children = get(ArtifactData.edit_fig, 'Children');
    for i = 1:length(children)
        if strcmp(get(children(i), 'Type'), 'axes')
            delete(children(i));
        end
    end
    
    area_idx = ArtifactData.selected_area;
    area_name = ArtifactData.ID{area_idx};
    
    % Calculate current window
    frame_start = ArtifactData.edit_start_frame;
    frame_end = min(frame_start + ArtifactData.edit_window_size - 1, ArtifactData.total_frames);
    
    % Update frame info
    frame_info_handle = findobj(ArtifactData.edit_fig, 'Tag', 'EditFrameInfo');
    set(frame_info_handle, 'String', sprintf('Frames %d-%d', frame_start, frame_end));
    
    % Get area data - handle channel flipping correctly
    area_corrected = ArtifactData.corrected_frames(area_idx, frame_start:frame_end);
    
    % Get original blue and purple signals
    area_blue_original = ArtifactData.session_blue(area_idx, frame_start:frame_end);
    area_purple_original = ArtifactData.session_purple(area_idx, frame_start:frame_end);
    
    % Get statistics
    if ~ArtifactData.mouse_stats.use_defaults && area_idx <= length(ArtifactData.mouse_stats.frames_std)
        area_std = ArtifactData.mouse_stats.frames_std(area_idx);
        area_median = ArtifactData.mouse_stats.frames_median(area_idx);
    else
        clean_data = area_corrected(~isnan(area_corrected) & ~isinf(area_corrected));
        if length(clean_data) > 50
            area_std = std(clean_data);
            area_median = median(clean_data);
        else
            area_std = 1;
            area_median = 0;
        end
    end
    
    % Main trace plot
    subplot(2, 2, [1, 2]);
    t = frame_start:frame_end;
    
    plot(t, area_corrected, 'k-', 'LineWidth', 2); hold on;
    
    % FIXED: Plot with correct labels based on channel flip status
    if ArtifactData.channels_flipped
        % After flip: the "blue" channel is now the old purple, "purple" channel is now the old blue
        plot(t, area_purple_original, 'b-', 'LineWidth', 1.5);    % This is now the "blue" channel
        plot(t, area_blue_original, 'Color', [0.5 0 0.5], 'LineWidth', 1.5);  % This is now the "purple" channel
        legend_entries = {'Corrected (Purple-Blue)', 'Blue Channel (was Purple)', 'Purple Channel (was Blue)'};
        corrected_desc = 'Channels Flipped';
    else
        % Normal case: corrected = blue - purple
        plot(t, area_blue_original, 'b-', 'LineWidth', 1.5);    % Blue signal
        plot(t, area_purple_original, 'Color', [0.5 0 0.5], 'LineWidth', 1.5);  % Purple signal
        legend_entries = {'Corrected (Blue-Purple)', 'Blue Channel', 'Purple Channel'};
        corrected_desc = 'Normal Configuration';
    end
    
    % Add std boundaries
    upper_bound = area_median + 3 * area_std;
    lower_bound = area_median - 3 * area_std;
    yline(upper_bound, 'g--', '+3 STD', 'LineWidth', 1);
    yline(lower_bound, 'g--', '-3 STD', 'LineWidth', 1);
    yline(area_median, 'g-', 'Median', 'LineWidth', 1);
    
    title(sprintf('%s - %s\nFrames %d-%d (%s)', ...
        ArtifactData.mouse_name, area_name, frame_start, frame_end, corrected_desc));
    xlabel('Frame Number');
    ylabel('Signal Intensity');
    
    legend(legend_entries, 'Location', 'best');
    grid on;
    
    % Histogram
