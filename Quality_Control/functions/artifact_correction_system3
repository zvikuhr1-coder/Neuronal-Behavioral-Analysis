function edit_scroll_callback(~, eventdata)
    global ArtifactData
    
    if ArtifactData.step ~= 3, return; end
    
    % Scroll through frames
    scroll_direction = eventdata.VerticalScrollCount;
    
    if scroll_direction < 0
        % Scroll up - previous frames
        ArtifactData.edit_start_frame = max(1, ArtifactData.edit_start_frame - ArtifactData.edit_window_size);
    else
        % Scroll down - next frames
        ArtifactData.edit_start_frame = min(ArtifactData.total_frames - ArtifactData.edit_window_size + 1, ...
            ArtifactData.edit_start_frame + ArtifactData.edit_window_size);
