function [tc_artifact_corrected] = artifact_correction_system3(session_blue, session_purple, session_frames, MOUSE_DATA, current_mouse_name)
    % Interactive artifact detection and correction system with callbacks
    % Input: 
    %   session_blue - blue signal for current session
    %   session_purple - purple signal for current session  
    %   session_frames - corrected frames for current session
    %   MOUSE_DATA - structure containing all mouse data for calculating statistics
    %   current_mouse_name - name of current mouse being processed
    % Output:
    %   tc_artifact_corrected - corrected frames signal for this session
    
    % Brain area IDs
    ID = {'S1BF','CPU','S1BF(2)','GP','M1','Re','Re(2)',...
          'BLA','BLA(2)','S1BF(3)','CeM','RT','S1BF(4)','VPM','CA3','CA3(2)','CA1','DG','Re(3)',...
          'PRh','DLEnt','DIEnt','VIEnt','VIEnt(2)','DG(2)','Ment','DG(3)','Post','RSD',...
          'DLEnt(2)','Ment(2)','TEA','CEnt','CEnt(2)','V1','Prs','Post(2)'};
    
    fprintf('\n=== Interactive Artifact Correction for Mouse: %s ===\n', current_mouse_name);
    
    % Initialize global data structure for callbacks
    global ArtifactData
    ArtifactData = struct();
    ArtifactData.session_blue = session_blue;
    ArtifactData.session_purple = session_purple;
    ArtifactData.session_frames = session_frames;
    ArtifactData.corrected_frames = session_frames;
    ArtifactData.ID = ID;
    ArtifactData.mouse_name = current_mouse_name;
    ArtifactData.current_path = pwd;
    ArtifactData.total_frames = size(session_frames, 2);
    ArtifactData.num_areas = min(size(session_frames, 1), length(ID));
    ArtifactData.sampling_rate = 10;
    ArtifactData.current_start_frame = 1;
    ArtifactData.window_size = 600;
    ArtifactData.selected_area = [];
    ArtifactData.modifications = {};
    ArtifactData.step = 1; % 1=flip check, 2=trace selection, 3=trace editing, 4=review
    ArtifactData.channels_flipped = false;
    % Calculate mouse-specific statistics
    ArtifactData.mouse_stats = calculate_mouse_statistics(MOUSE_DATA, current_mouse_name, ID);
    
    % Step 1: Check for channel flipping (first 600 frames only)
    check_channel_flip_interactive();
    
    % Wait for user to complete all steps
    waitfor_completion();
    
    % Return corrected data
    tc_artifact_corrected = ArtifactData.corrected_frames;
    
    fprintf('\n=== Artifact correction completed for mouse %s ===\n', current_mouse_name);
    
    % Clear global data
    clear global ArtifactData
end

function waitfor_completion()
    global ArtifactData
    
    % Wait until step 4 is completed
    while ArtifactData.step < 5
        pause(0.1);
        drawnow;
    end
end

function check_channel_flip_interactive()
    global ArtifactData
    
    fprintf('\nStep 1: Checking for channel flipping (first 600 frames)...\n');
    
    % Create figure for flip check
    fig = figure('Name', sprintf('%s - Channel Flip Check', ArtifactData.mouse_name));
    set(fig, 'Position', get(0, 'Screensize'));
    set(fig, 'CloseRequestFcn', @close_flip_check);
    
    ArtifactData.flip_fig = fig;
    
    % Create UI controls
    uicontrol('Style', 'pushbutton', 'String', 'Traces Look Normal', ...
        'Position', [50, 50, 150, 40], 'Callback', @keep_normal_callback, ...
        'FontSize', 12, 'BackgroundColor', [0.8 1 0.8]);
    
    uicontrol('Style', 'pushbutton', 'String', 'Traces Look Flipped', ...
        'Position', [220, 50, 150, 40], 'Callback', @flip_channels_callback, ...
        'FontSize', 12, 'BackgroundColor', [1 0.8 0.8]);
    
    % Plot the traces (first 600 frames only)
    plot_flip_check_traces();
end

function plot_flip_check_traces()
    global ArtifactData
    
    figure(ArtifactData.flip_fig);
    
    % Clear previous plots
    clf(ArtifactData.flip_fig);
    
    % Recreate buttons
    uicontrol('Style', 'pushbutton', 'String', 'Traces Look Normal', ...
        'Position', [50, 50, 150, 40], 'Callback', @keep_normal_callback, ...
        'FontSize', 12, 'BackgroundColor', [0.8 1 0.8]);
    
    uicontrol('Style', 'pushbutton', 'String', 'Traces Look Flipped', ...
        'Position', [220, 50, 150, 40], 'Callback', @flip_channels_callback, ...
        'FontSize', 12, 'BackgroundColor', [1 0.8 0.8]);
    
    % Create subplots
    hsp(1) = subplot(1,2,1);
    hsp(2) = subplot(1,2,2);
    set(hsp(1),'Position',[0.1300 0.1100 0.3347 0.8150]);
    set(hsp(2),'Position',[0.5703 0.1100 0.3347 0.8150]);
    
    % Use first 600 frames only
    frame_end = min(600, ArtifactData.total_frames);
    time_sec = (0:frame_end-1)/ArtifactData.sampling_rate;
    
    half_areas = ceil(ArtifactData.num_areas / 2);
    deltaF = 0.05;
    
    % Plot first half of areas
    subplot(hsp(1))
    set(gca,'color','w')
    for i = 1:half_areas
        hold on
        if i == 1
            plot([max(time_sec)-4, max(time_sec)-4], [0, deltaF], 'k', 'LineWidth', 2)
            text(max(time_sec)-3, deltaF/2, sprintf('%.2f', deltaF), 'FontSize', 10)
        end
        plot(time_sec, ArtifactData.corrected_frames(i, 1:frame_end) - i*deltaF, 'b', 'LineWidth', 2)
    end
    
    ytick_pos = [-deltaF*half_areas:deltaF:0];
    ytick_labels = [fliplr(ArtifactData.ID(1:half_areas)), {'\DeltaF/F'}];
    set(gca, 'Ytick', ytick_pos, 'YtickLabel', ytick_labels)
    xlim([0 max(time_sec)])
    xlabel('Time (s)')
    title('First Half of Brain Areas')
    
    % Plot second half of areas
    subplot(hsp(2))
    set(gca,'color','w')
    remaining_areas = ArtifactData.num_areas - half_areas;
    for i = 1:remaining_areas
        hold on
        area_idx = half_areas + i;
        if i == 1
            plot([max(time_sec)-4, max(time_sec)-4], [0, deltaF], 'k', 'LineWidth', 2)
            text(max(time_sec)-3, deltaF/2, sprintf('%.2f', deltaF), 'FontSize', 10)
        end
        plot(time_sec, ArtifactData.corrected_frames(area_idx, 1:frame_end) - i*deltaF, 'b', 'LineWidth', 2)
    end
    
    ytick_pos = [-deltaF*remaining_areas:deltaF:0];
    ytick_labels = [fliplr(ArtifactData.ID(half_areas+1:ArtifactData.num_areas)), {'\DeltaF/F'}];
    set(gca, 'Ytick', ytick_pos, 'YtickLabel', ytick_labels)
    xlim([0 max(time_sec)])
    xlabel('Time (s)')
    title('Second Half of Brain Areas')
    
    sgtitle(sprintf('Session: %s\nMouse: %s - Do the traces look flipped?\nFirst 600 frames (0-%.1f s)', ...
        ArtifactData.current_path, ArtifactData.mouse_name, max(time_sec)));
end

function keep_normal_callback(~, ~)
    global ArtifactData
    
    fprintf('Keeping original channel configuration.\n');
    close(ArtifactData.flip_fig);
    
    % Move to step 2
    ArtifactData.step = 2;
    show_trace_selection();
end

function flip_channels_callback(~, ~)
    global ArtifactData
    
    fprintf('Flipping channels: corrected = purple - blue\n');
    
    % Flip the calculation
    ArtifactData.corrected_frames = ArtifactData.session_purple - ArtifactData.session_blue;
    ArtifactData.channels_flipped = true; % Track that channels are flipped
    
    % Update the plot to show flipped version
    plot_flip_check_traces();
    
    % Add confirmation button
    uicontrol('Style', 'pushbutton', 'String', 'Confirm Flip', ...
        'Position', [400, 50, 150, 40], 'Callback', @confirm_flip_callback, ...
        'FontSize', 12, 'BackgroundColor', [0.8 0.8 1]);
end

function confirm_flip_callback(~, ~)
    global ArtifactData
    
    fprintf('Channels have been flipped and confirmed.\n');
    close(ArtifactData.flip_fig);
    
    % Move to step 2
    ArtifactData.step = 2;
    show_trace_selection();
end

