function arena_polygon = define_arena_boundary(data_path)
% DEFINE_ARENA_BOUNDARY Interactive polygon drawing for arena boundary
%
% Syntax:
%   arena_polygon = define_arena_boundary(data_path)
%
% Description:
%   Displays the background frame and prompts user to draw a polygon defining
%   the arena boundaries. This ROI is used to filter out tracking points that
%   fall outside the experimental arena.
%
% Input:
%   data_path - Directory containing background_frame.mat
%
% Output:
%   arena_polygon - MATLAB polygon object with boundary coordinates
%
% Output Files:
%   arena_polygon.mat - Contains 'arena_polygon' variable
%
% Interactive Use:
%   1. Function displays background frame
%   2. User draws polygon by clicking vertices on arena perimeter
%   3. Double-click to complete polygon
%   4. Polygon is automatically saved
%
% Notes:
%   - Requires background_frame.mat to exist
%   - More vertices = more accurate boundary definition
%
% See also: extract_background_frame, drawpolygon

cd(data_path);

% Load background frame
if ~exist('background_frame.mat', 'file')
    error('background_frame.mat not found. Run extract_background_frame first.');
end

load('background_frame.mat', 'background_frame');

% Display background frame
figure('Name', 'Arena Boundary Definition');
imagesc(background_frame);
axis image;
hold on;
title('Draw polygon around arena perimeter (double-click to finish)');
xlabel('X coordinate (pixels)');
ylabel('Y coordinate (pixels)');

% Interactive polygon drawing
arena_polygon = drawpolygon('Label', 'Arena', 'Color', 'r', 'LineWidth', 2);

% Wait for user to complete polygon
wait(arena_polygon);

% Save polygon ROI
save('arena_polygon', 'arena_polygon');

fprintf('✓ Arena polygon saved (%d vertices)\n', size(arena_polygon.Position, 1));

end
