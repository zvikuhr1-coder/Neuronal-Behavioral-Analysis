function parse_video_timestamps(data_path)
% PARSE_VIDEO_TIMESTAMPS Parse FFmpeg timestamp output into MATLAB array
%
% Syntax:
%   parse_video_timestamps(data_path)
%
% Description:
%   Reads text file generated by FFmpeg and extracts frame timestamps into
%   MATLAB array for synchronization with imaging acquisition.
%
% Input:
%   data_path - Directory containing timestamp text file
%
% Output:
%   processed/video_timestamps.mat - Nx1 array of frame times (seconds)
%
% FFmpeg Output Format:
%   frame,best_effort_timestamp_time,pts_time
%   frame,0.000000
%   frame,0.050000
%   ...
%
% Notes:
%   - Requires FFmpeg batch execution first
%   - Validates monotonically increasing timestamps
%   - Reports frame rate statistics
%
% See also: execute_ffmpeg_batch

% Define paths
processed_path = fullfile(data_path, 'processed');
if ~exist(processed_path, 'dir')
    mkdir(processed_path);
end

cd(data_path);

% Locate timestamp text file
txt_files = dir('*.txt');
if isempty(txt_files)
    error('No timestamp file found. Run execute_ffmpeg_batch first.');
end

txt_file = fullfile(txt_files(1).folder, txt_files(1).name);
fprintf('Reading: %s\n', txt_files(1).name);

% Read file content
file_content = fileread(txt_file);
lines = strsplit(file_content, '\n');

% Extract timestamps
video_timestamps = [];
for i = 1:length(lines)
    line = lines{i};
    if contains(line, 'pts_time:')
        % Extract numeric value after 'pts_time:'
        token = regexp(line, 'pts_time:([\d.]+)', 'tokens');
        if ~isempty(token)
            video_timestamps = [video_timestamps; str2double(token{1})];
        end
    end
end

% Validate timestamps
if isempty(video_timestamps)
    error('No timestamps extracted from file');
end

fprintf('Extracted %d timestamps\n', length(video_timestamps));

% Check monotonicity
time_diffs = diff(video_timestamps);
if any(time_diffs < 0)
    warning('Timestamps not monotonically increasing');
end

% Statistics
duration = video_timestamps(end) - video_timestamps(1);
median_fps = 1 / median(time_diffs);

fprintf('Duration: %.2f s (%.2f min)\n', duration, duration / 60);
fprintf('Median FPS: %.2f Hz\n', median_fps);

% Save to processed folder
cd(processed_path);
save('video_timestamps.mat', 'video_timestamps');
fprintf('✓ Saved: processed/video_timestamps.mat\n');

cd(data_path);

end
