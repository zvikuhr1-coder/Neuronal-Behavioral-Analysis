%% Behavioral Tracking and Synchronization Pipeline
% =========================================================================
% Synchronizes DeepLabCut behavioral tracking with calcium imaging frames.
% Processes video timestamps, filters arena boundaries, corrects artifacts,
% and produces frame-aligned datasets.
%
% REQUIREMENTS:
%   Input Files:
%   - video.avi (behavioral recording)
%   - DLC_tracking.csv (DeepLabCut output - run DLC before this pipeline)
%   - trial*.dcimg (imaging files)
%   - processed/trial_*_corrected.mat (from neuronal pipeline)
%
%   External Software:
%   - FFmpeg (batch file included in functions/ folder)
%   - DeepLabCut (for CSV generation - external tool)
%
%   Functions (in functions/ subfolder):
%   - extract_background_frame.m
%   - define_arena_boundary.m
%   - execute_ffmpeg_batch.m
%   - parse_video_timestamps.m
%   - detect_trial_onsets.m
%   - synchronize_tracking_imaging.m
%   - filter_arena_coordinates.m (utility)
%   - correct_tracking_outliers.m (utility)
%
% OUTPUT:
%   processed/
%   - synchronized_tracking.mat (x_position_aligned, y_position_aligned)
%   - imaging_data_aligned.mat (concatenated imaging data)
%   - frame_alignment_indices.mat
%   - interpolation_markers.mat
%   - video_timestamps.mat
%   - trial_starts.mat
%
% Author: [Your Name]
% GitHub: [Repository URL]
% =========================================================================

%% Setup
clear; close all; clc;

% Add functions to path
addpath(fullfile(pwd, 'functions'));

% ==========================================================================
% USER CONFIGURATION
% ==========================================================================

% Data path containing video, DLC CSV, and imaging files
data_path = 'C:\Path\To\Your\Data\Folder';

% ==========================================================================

fprintf('\n=====================================================\n');
fprintf('  BEHAVIORAL TRACKING & SYNCHRONIZATION PIPELINE\n');
fprintf('=====================================================\n\n');
fprintf('Data: %s\n\n', data_path);

%% Validate Inputs
fprintf('Validating inputs...\n');

if ~exist(data_path, 'dir')
    error('Data directory not found: %s', data_path);
end

% Check video file
video_files = dir(fullfile(data_path, '*.avi'));
if isempty(video_files)
    error('No .avi video file found');
end
fprintf('  ✓ Video: %s\n', video_files(1).name);

% Check DLC CSV
csv_files = dir(fullfile(data_path, '*.csv'));
if isempty(csv_files)
    error('No CSV tracking file found. Run DeepLabCut first.');
end
fprintf('  ✓ DLC CSV: %s\n', csv_files(1).name);

% Check processed directory
processed_path = fullfile(data_path, 'processed');
if ~exist(processed_path, 'dir')
    mkdir(processed_path);
    fprintf('  ✓ Created processed/ directory\n');
else
    fprintf('  ✓ processed/ directory exists\n');
end

fprintf('\n');

%% Stage 1: Background Frame
fprintf('-----------------------------------------------------\n');
fprintf('STAGE 1: Extract Background Frame\n');
fprintf('-----------------------------------------------------\n');

if exist(fullfile(data_path, 'background_frame.mat'), 'file')
    fprintf('Background frame exists. Skipping...\n');
else
    extract_background_frame(data_path);
    fprintf('✓ Background frame created\n');
end
fprintf('\n');

%% Stage 2: Arena Boundary
fprintf('-----------------------------------------------------\n');
fprintf('STAGE 2: Define Arena Boundary\n');
fprintf('-----------------------------------------------------\n');

if exist(fullfile(data_path, 'arena_polygon.mat'), 'file')
    fprintf('Arena polygon exists. Skipping...\n');
else
    fprintf('Draw polygon around arena perimeter.\n');
    fprintf('Double-click to finish.\n\n');
    define_arena_boundary(data_path);
    fprintf('✓ Arena boundary defined\n');
end
fprintf('\n');

%% Stage 3: Video Timestamps
fprintf('-----------------------------------------------------\n');
fprintf('STAGE 3: Extract Video Timestamps\n');
fprintf('-----------------------------------------------------\n');

if exist(fullfile(processed_path, 'video_timestamps.mat'), 'file')
    fprintf('Timestamps exist. Skipping...\n');
else
    fprintf('Executing FFmpeg batch file...\n');
    execute_ffmpeg_batch(data_path);
    
    fprintf('Parsing timestamps...\n');
    parse_video_timestamps(data_path);
    fprintf('✓ Timestamps extracted\n');
end
fprintf('\n');

%% Stage 4: Trial Onsets
fprintf('-----------------------------------------------------\n');
fprintf('STAGE 4: Detect Trial Onsets\n');
fprintf('-----------------------------------------------------\n');

if exist(fullfile(processed_path, 'trial_starts.mat'), 'file')
    fprintf('Trial starts exist. Loading...\n');
    load(fullfile(processed_path, 'trial_starts.mat'), 'trial_starts');
    fprintf('  ✓ %d trials\n', length(trial_starts));
else
    fprintf('Draw circle around LED indicator.\n');
    fprintf('Verify each detected trial.\n\n');
    trial_starts = detect_trial_onsets(data_path);
    fprintf('✓ %d trials detected\n', length(trial_starts));
end
fprintf('\n');

%% Stage 5: Synchronization
fprintf('-----------------------------------------------------\n');
fprintf('STAGE 5: Synchronize Tracking and Imaging\n');
fprintf('-----------------------------------------------------\n');

sync_file = fullfile(processed_path, 'synchronized_tracking.mat');
if exist(sync_file, 'file')
    fprintf('Synchronized data exists. Skipping...\n');
    load(sync_file, 'x_position_aligned', 'y_position_aligned');
    fprintf('  ✓ %d frames\n', length(x_position_aligned));
else
    synchronize_tracking_imaging(data_path);
    load(sync_file, 'x_position_aligned', 'y_position_aligned');
    fprintf('✓ Synchronization complete: %d frames\n', length(x_position_aligned));
end
fprintf('\n');

%% Summary
fprintf('=====================================================\n');
fprintf('  PIPELINE COMPLETE\n');
fprintf('=====================================================\n\n');

% Load final data
imaging_file = fullfile(processed_path, 'imaging_data_aligned.mat');
if exist(imaging_file, 'file')
    load(imaging_file, 'imaging_data_aligned');
    fprintf('Output Summary:\n');
    fprintf('  Tracking: %d frames\n', length(x_position_aligned));
    fprintf('  Imaging: %d ROIs × %d frames\n', ...
            size(imaging_data_aligned, 1), ...
            size(imaging_data_aligned, 2));
    fprintf('  Valid data: %.1f%%\n\n', ...
            100 * sum(~isnan(x_position_aligned)) / length(x_position_aligned));
end

fprintf('Output Location: %s\n', processed_path);
fprintf('Key Files:\n');
fprintf('  - synchronized_tracking.mat\n');
fprintf('  - imaging_data_aligned.mat\n');
fprintf('  - frame_alignment_indices.mat\n');
fprintf('  - video_timestamps.mat\n');
fprintf('  - trial_starts.mat\n\n');

fprintf('=====================================================\n\n');
