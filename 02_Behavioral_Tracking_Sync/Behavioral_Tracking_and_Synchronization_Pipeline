%% Behavioral Tracking and Synchronization Pipeline
% =========================================================================
% Synchronizes DeepLabCut behavioral tracking with calcium imaging frames.
% Processes video timestamps, filters arena boundaries, corrects artifacts,
% and produces frame-aligned datasets.
%
% REQUIREMENTS:
%   Input Files:
%   - video.avi (behavioral recording)
%   - DLC_tracking.csv (DeepLabCut output)
%   - trial*.dcimg (imaging files)
%   - Matt_files/tc_all_brain_areas_CORRECTED*.mat (from neuronal pipeline)
%
%   External Software:
%   - FFmpeg (timestamp extraction)
%   - DeepLabCut (run before this pipeline)
%
%   Functions:
%   - process_background.m
%   - define_arena_roi.m
%   - batch_file_handler.m
%   - extract_video_timestamps.m
%   - detect_trial_starts.m
%   - synchronize_behavior_imaging.m
%
% OUTPUT:
%   Matt_files/
%   - correctedTrackingData.mat (x_CORRECTED_ALL, y_CORRECTED_ALL)
%   - tc_all_brain_areas_CORRECTED_ALL.mat
%   - vec_for_vid_new.mat, vec_for_intorp_new.mat
%   - timestamps.mat, trials_start.mat
%
% Author: [Your Name]
% GitHub: [Repository URL]
% =========================================================================

%% Setup
clear; close all; clc;

% Add functions to path
addpath(fullfile(pwd, 'functions'));

% ==========================================================================
% USER CONFIGURATION
% ==========================================================================

% Data path containing video, DLC CSV, and imaging files
behav_path = 'D:\AD_6\AD21\1L1R\TEST';

% FFmpeg batch file path for timestamp extraction
batch_file_path = 'K:\extract_timestamps.bat';

% ==========================================================================

fprintf('\n=====================================================\n');
fprintf('  BEHAVIORAL TRACKING & SYNCHRONIZATION PIPELINE\n');
fprintf('=====================================================\n\n');
fprintf('Data: %s\n\n', behav_path);

%% Validate Inputs
fprintf('Validating inputs...\n');

if ~exist(behav_path, 'dir')
    error('Data directory not found: %s', behav_path);
end

% Check video file
video_files = dir(fullfile(behav_path, '*.avi'));
if isempty(video_files)
    error('No .avi video file found');
end
fprintf('  ✓ Video: %s\n', video_files(1).name);

% Check DLC CSV
csv_files = dir(fullfile(behav_path, '*.csv'));
if isempty(csv_files)
    error('No CSV tracking file found. Run DeepLabCut first.');
end
fprintf('  ✓ DLC CSV: %s\n', csv_files(1).name);

% Check Matt_files directory
brain_path = fullfile(behav_path, 'Matt_files');
if ~exist(brain_path, 'dir')
    mkdir(brain_path);
    fprintf('  ✓ Created Matt_files directory\n');
else
    fprintf('  ✓ Matt_files directory exists\n');
end

fprintf('\n');

%% Stage 1: Background Frame
fprintf('-----------------------------------------------------\n');
fprintf('STAGE 1: Generate Background Frame\n');
fprintf('-----------------------------------------------------\n');

if exist(fullfile(behav_path, 'background_frame.mat'), 'file')
    fprintf('Background frame exists. Skipping...\n');
else
    process_background(behav_path);
    fprintf('✓ Background frame created\n');
end
fprintf('\n');

%% Stage 2: Arena Boundaries
fprintf('-----------------------------------------------------\n');
fprintf('STAGE 2: Define Arena Boundaries\n');
fprintf('-----------------------------------------------------\n');

if exist(fullfile(behav_path, 'arenaPolygon.mat'), 'file')
    fprintf('Arena polygon exists. Skipping...\n');
else
    fprintf('Draw polygon around arena perimeter.\n');
    fprintf('Double-click to finish.\n\n');
    define_arena_roi(behav_path);
    fprintf('✓ Arena boundaries defined\n');
end
fprintf('\n');

%% Stage 3: Video Timestamps
fprintf('-----------------------------------------------------\n');
fprintf('STAGE 3: Extract Video Timestamps\n');
fprintf('-----------------------------------------------------\n');

if exist(fullfile(brain_path, 'timestamps.mat'), 'file')
    fprintf('Timestamps exist. Skipping...\n');
else
    if ~exist(batch_file_path, 'file')
        error('FFmpeg batch file not found: %s', batch_file_path);
    end
    
    fprintf('Executing FFmpeg batch file...\n');
    batch_file_handler(behav_path, batch_file_path);
    
    fprintf('Parsing timestamps...\n');
    extract_video_timestamps(behav_path);
    fprintf('✓ Timestamps extracted\n');
end
fprintf('\n');

%% Stage 4: Trial Starts
fprintf('-----------------------------------------------------\n');
fprintf('STAGE 4: Detect Trial Starts\n');
fprintf('-----------------------------------------------------\n');

if exist(fullfile(brain_path, 'trials_start.mat'), 'file')
    fprintf('Trial starts exist. Loading...\n');
    load(fullfile(brain_path, 'trials_start.mat'), 'trials_start');
    fprintf('  ✓ %d trials\n', length(trials_start));
else
    fprintf('Draw circle around LED indicator.\n');
    fprintf('Verify each detected trial.\n\n');
    trials_start = detect_trial_starts(behav_path);
    fprintf('✓ %d trials detected\n', length(trials_start));
end
fprintf('\n');

%% Stage 5: Synchronization
fprintf('-----------------------------------------------------\n');
fprintf('STAGE 5: Synchronize Behavior and Imaging\n');
fprintf('-----------------------------------------------------\n');

corrected_file = fullfile(brain_path, 'correctedTrackingData.mat');
if exist(corrected_file, 'file')
    fprintf('Synchronized data exists. Skipping...\n');
    load(corrected_file, 'x_CORRECTED_ALL', 'y_CORRECTED_ALL');
    fprintf('  ✓ %d frames\n', length(x_CORRECTED_ALL));
else
    synchronize_behavior_imaging(behav_path);
    load(corrected_file, 'x_CORRECTED_ALL', 'y_CORRECTED_ALL');
    fprintf('✓ Synchronization complete: %d frames\n', length(x_CORRECTED_ALL));
end
fprintf('\n');

%% Summary
fprintf('=====================================================\n');
fprintf('  PIPELINE COMPLETE\n');
fprintf('=====================================================\n\n');

% Load final data
imaging_file = fullfile(brain_path, 'tc_all_brain_areas_CORRECTED_ALL.mat');
if exist(imaging_file, 'file')
    load(imaging_file, 'tc_all_brain_areas_CORRECTED_ALL');
    fprintf('Output Summary:\n');
    fprintf('  Tracking: %d frames\n', length(x_CORRECTED_ALL));
    fprintf('  Imaging: %d ROIs × %d frames\n', ...
            size(tc_all_brain_areas_CORRECTED_ALL, 1), ...
            size(tc_all_brain_areas_CORRECTED_ALL, 2));
    fprintf('  Valid data: %.1f%%\n\n', ...
            100 * sum(~isnan(x_CORRECTED_ALL)) / length(x_CORRECTED_ALL));
end

fprintf('Output Location: %s\n', brain_path);
fprintf('Key Files:\n');
fprintf('  - correctedTrackingData.mat\n');
fprintf('  - tc_all_brain_areas_CORRECTED_ALL.mat\n');
fprintf('  - vec_for_vid_new.mat\n');
fprintf('  - timestamps.mat\n');
fprintf('  - trials_start.mat\n\n');

fprintf('=====================================================\n\n');
