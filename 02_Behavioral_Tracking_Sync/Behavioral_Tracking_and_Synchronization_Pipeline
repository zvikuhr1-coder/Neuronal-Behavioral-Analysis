%% Behavioral Tracking and Synchronization Pipeline
% =========================================================================
% This pipeline synchronizes DeepLabCut (DLC) behavioral tracking data with
% calcium imaging acquisition. It processes video timestamps, detects trial
% starts via LED indicators, filters tracking artifacts, and produces
% frame-by-frame aligned datasets for integrated behavior-neural analysis.
%
% PIPELINE OVERVIEW:
% 1. Generate background frame for arena visualization
% 2. Define arena boundaries (interactive ROI drawing)
% 3. Extract video frame timestamps using FFmpeg
% 4. Detect trial start frames via LED analysis
% 5. Synchronize DLC tracking with imaging frames
%
% REQUIREMENTS:
%   Data Directory Structure:
%   - video.avi (behavioral video recording)
%   - tracking_data.csv (DeepLabCut output - see README)
%   - trial1.dcimg, trial2.dcimg, ... (calcium imaging files)
%   - Matt_files/tc_all_brain_areas_CORRECTED*.mat (processed imaging data)
%
%   External Software:
%   - FFmpeg (for timestamp extraction)
%   - DeepLabCut (for generating tracking CSV - run before this pipeline)
%
%   MATLAB Toolboxes:
%   - Image Processing Toolbox
%
%   Functions (in functions/ subdirectory):
%   - process_background.m
%   - define_arena_roi.m
%   - batch_file_handler.m
%   - extract_video_timestamps.m
%   - detect_trial_starts.m
%   - removeOutsideArenaPoints2.m
%   - tracking_outlier_correction.m
%   - synchronize_behavior_imaging.m
%
% ABOUT DEEPLABCUT (DLC) TRACKING:
%   This pipeline requires a CSV file generated by DeepLabCut, an external
%   deep learning-based pose estimation tool. DLC must be run BEFORE this
%   pipeline to produce frame-by-frame tracking coordinates.
%
%   DLC Workflow (performed externally):
%   1. Label body parts on sample video frames
%   2. Train neural network for pose estimation
%   3. Run inference on behavioral videos
%   4. Export tracking results as CSV file
%
%   The DLC CSV contains X/Y pixel coordinates of tracked body parts
%   (nose, ears, body center, etc.) for each video frame. This pipeline
%   reads the CSV, filters invalid points, and aligns coordinates with
%   calcium imaging acquisition frames.
%
%   For DLC installation and usage: https://deeplabcut.github.io/
%
% OUTPUT FILES:
%   Located in Matt_files subdirectory:
%   - correctedTrackingData.mat: Synchronized X/Y coordinates
%   - tc_all_brain_areas_CORRECTED_ALL.mat: Concatenated imaging data
%   - vec_for_vid_new.mat: Frame alignment indices
%   - vec_for_intorp_new.mat: Interpolation markers
%   - trials_start.mat: Trial start frame indices
%   - background_frame.mat: Average background image
%   - arenaPolygon.mat: Arena boundary definition
%   - timestamps.mat: Video frame timestamps
%

% =========================================================================

%% Setup
clear; close all; clc;

% Add functions directory to MATLAB path
addpath(fullfile(pwd, 'functions'));

% ==========================================================================
% USER CONFIGURATION - MODIFY THESE PATHS FOR YOUR DATA
% ==========================================================================

% Path to folder containing behavioral video, DLC tracking CSV, and imaging files
data_path = 'C:\Path\To\Your\Data\Folder';

% Path to FFmpeg batch file for timestamp extraction
% This batch file should contain FFmpeg commands like:
% ffprobe -select_streams v:0 -show_entries frame=pts_time -of csv=p=0 video.avi > timestamps.csv
batch_file_path = 'K:\extract_timestamps.bat';

% Analysis parameters
params.show_plots = true;           % Display diagnostic plots
params.interactive_mode = true;     % Prompt for user verification

% ==========================================================================

fprintf('\n');
fprintf('=====================================================\n');
fprintf('  BEHAVIORAL TRACKING & SYNCHRONIZATION PIPELINE    \n');
fprintf('=====================================================\n');
fprintf('\n');
fprintf('Data location: %s\n', data_path);
fprintf('Batch file: %s\n', batch_file_path);
fprintf('\n');

% Validate data directory exists
if ~exist(data_path, 'dir')
    error('Data directory does not exist: %s', data_path);
end

% Validate required input files
fprintf('Validating input files...\n');

% Check for video file
video_files = dir(fullfile(data_path, '*.avi'));
if isempty(video_files)
    error('No .avi video file found in %s', data_path);
end
fprintf('  ✓ Video file found: %s\n', video_files(1).name);

% Check for DLC tracking CSV
csv_files = dir(fullfile(data_path, '*.csv'));
if isempty(csv_files)
    error(['No CSV tracking file found in %s\n', ...
           'Please run DeepLabCut on your video first to generate tracking coordinates.'], ...
           data_path);
end
fprintf('  ✓ DLC tracking CSV found: %s\n', csv_files(1).name);

% Check for imaging files
imaging_files = dir(fullfile(data_path, '*.dcimg'));
if isempty(imaging_files)
    warning(['No .dcimg imaging files found. Pipeline will proceed but ', ...
             'cannot determine number of trials automatically.']);
else
    fprintf('  ✓ Imaging files found: %d trials\n', length(imaging_files));
end

fprintf('\n');

%% STAGE 1: Generate Background Frame
% =========================================================================
% Creates averaged background image from video for arena visualization
% 
% Input Required:
%   - video.avi
%
% Output:
%   - background_frame.mat (averaged frame)
%   - vid_dim.mat (video dimensions)
%
% Purpose:
%   Provides clean reference image for drawing arena boundaries
% =========================================================================

fprintf('-----------------------------------------------------\n');
fprintf('STAGE 1: Generating Background Frame\n');
fprintf('-----------------------------------------------------\n');

% Check if already processed
background_file = fullfile(data_path, 'background_frame.mat');
if exist(background_file, 'file')
    fprintf('Background frame already exists. Skipping...\n');
else
    fprintf('Sampling 150 random frames from video...\n');
    process_background(data_path);
    fprintf('✓ Background frame created\n');
end

fprintf('\n');

%% STAGE 2: Define Arena Boundaries
% =========================================================================
% Interactive polygon drawing to define valid tracking region
% 
% Input Required:
%   - background_frame.mat (from Stage 1)
%
% Output:
%   - arenaPolygon.mat (polygon ROI object)
%
% User Instructions:
%   1. Click vertices along arena perimeter
%   2. Double-click to complete polygon
%   3. Ensure polygon encompasses entire usable area
%
% Purpose:
%   Filter out tracking points outside experimental arena, removing
%   artifacts from animal detection outside boundaries
% =========================================================================

fprintf('-----------------------------------------------------\n');
fprintf('STAGE 2: Defining Arena Boundaries\n');
fprintf('-----------------------------------------------------\n');

% Check if already defined
arena_file = fullfile(data_path, 'arenaPolygon.mat');
if exist(arena_file, 'file')
    fprintf('Arena polygon already exists. Skipping...\n');
else
    fprintf('\n*** INTERACTIVE STEP ***\n');
    fprintf('A figure will appear showing the arena background.\n');
    fprintf('Instructions:\n');
    fprintf('  1. Click vertices along the arena perimeter\n');
    fprintf('  2. Double-click to complete the polygon\n');
    fprintf('  3. Make sure the polygon encompasses the entire arena\n');
    fprintf('\nPress any key to continue...');
    if params.interactive_mode
        pause;
    end
    fprintf('\n\n');
    
    arena_polygon = define_arena_roi(data_path);
    fprintf('✓ Arena boundaries defined with %d vertices\n', ...
            size(arena_polygon.Position, 1));
end

fprintf('\n');

%% STAGE 3: Extract Video Frame Timestamps
% =========================================================================
% Uses FFmpeg to extract precise frame timing from video metadata
% 
% Input Required:
%   - video.avi
%   - extract_timestamps.bat (FFmpeg batch file)
%
% Output:
%   - timestamps.mat (Nx1 array of frame times in seconds)
%
% Process:
%   1. Copy FFmpeg batch file to data directory
%   2. Execute batch file to extract timestamps
%   3. Parse CSV output into MATLAB array
%
% Purpose:
%   Accurate temporal alignment requires precise frame timing.
%   Video metadata provides millisecond-precision timestamps for
%   synchronization with 10Hz imaging acquisition.
% =========================================================================

fprintf('-----------------------------------------------------\n');
fprintf('STAGE 3: Extracting Video Frame Timestamps\n');
fprintf('-----------------------------------------------------\n');

% Check if already extracted
timestamps_file = fullfile(data_path, 'Matt_files', 'timestamps.mat');
if exist(timestamps_file, 'file')
    fprintf('Timestamps already exist. Skipping...\n');
else
    fprintf('Step 3a: Copying and executing FFmpeg batch file...\n');
    
    % Validate batch file exists
    if ~exist(batch_file_path, 'file')
        error(['FFmpeg batch file not found: %s\n', ...
               'Please update batch_file_path in configuration section.'], ...
               batch_file_path);
    end
    
    batch_file_handler(data_path, batch_file_path);
    fprintf('  ✓ FFmpeg executed\n');
    
    fprintf('Step 3b: Parsing timestamp CSV...\n');
    extract_video_timestamps(data_path);
    fprintf('  ✓ Timestamps extracted and saved\n');
end

fprintf('\n');

%% STAGE 4: Detect Trial Start Frames
% =========================================================================
% Identifies trial start times via LED indicator change detection
% 
% Input Required:
%   - video.avi
%   - timestamps.mat (from Stage 3)
%   - tc_all_brain_areas_CORRECTED1.mat (to determine number of trials)
%
% Output:
%   - trials_start.mat (Nx1 array of trial start frame indices)
%   - LED_start_*.mat (legacy format)
%
% User Instructions:
%   1. Draw circle around LED indicator
%   2. Verify each detected trial start
%   3. Manually adjust if automatic detection is incorrect
%
% Algorithm:
%   - Analyzes LED intensity in first 60 seconds
%   - Detects first trial via linear change point detection
%   - Calculates subsequent trials assuming 5-minute (300s) intervals
%   - User verifies each trial with ±20s visualization window
%
% Purpose:
%   Accurate trial segmentation is critical for proper temporal alignment
%   across behavioral and imaging modalities
% =========================================================================

fprintf('-----------------------------------------------------\n');
fprintf('STAGE 4: Detecting Trial Start Frames\n');
fprintf('-----------------------------------------------------\n');

% Check if already detected
trials_file = fullfile(data_path, 'Matt_files', 'trials_start.mat');
if exist(trials_file, 'file')
    fprintf('Trial starts already detected. Loading existing data...\n');
    load(trials_file, 'trials_start');
    fprintf('  ✓ Loaded %d trials\n', length(trials_start));
else
    fprintf('\n*** INTERACTIVE STEP ***\n');
    fprintf('Step 4a: LED ROI Selection\n');
    fprintf('A figure will show the first video frame.\n');
    fprintf('Draw a circle around the LED indicator.\n');
    fprintf('\n');
    
    if params.interactive_mode
        fprintf('Press any key to continue...');
        pause;
        fprintf('\n\n');
    end
    
    fprintf('Step 4b: Detecting first trial via LED change point...\n');
    fprintf('Step 4c: Calculating subsequent trial starts (300s intervals)...\n');
    fprintf('Step 4d: User verification of each trial...\n');
    fprintf('\n');
    
    trials_start = detect_trial_starts(data_path);
    fprintf('✓ Trial starts detected and verified\n');
    fprintf('  Detected %d trials\n', length(trials_start));
end

fprintf('\n');

%% STAGE 5: Synchronize Behavior and Imaging
% =========================================================================
% Aligns DLC tracking coordinates with calcium imaging frames
% 
% Input Required:
%   - tracking_data.csv (DLC output)
%   - timestamps.mat (from Stage 3)
%   - trials_start.mat (from Stage 4)
%   - arenaPolygon.mat (from Stage 2)
%   - tc_all_brain_areas_CORRECTED*.mat (one per trial)
%
% Output:
%   - correctedTrackingData.mat (x_CORRECTED_ALL, y_CORRECTED_ALL)
%   - tc_all_brain_areas_CORRECTED_ALL.mat (concatenated imaging data)
%   - vec_for_vid_new.mat (frame alignment indices)
%   - vec_for_intorp_new.mat (interpolation markers)
%
% Process:
%   1. Load DLC tracking CSV (X/Y coordinates from multiple body parts)
%   2. Take median across body parts for robust tracking
%   3. Filter points outside arena (replaced with NaN)
%   4. Create temporal mapping: imaging frame → video frame
%   5. For each trial:
%      - Adjust timestamps relative to trial start
%      - Map each 10Hz imaging frame to nearest ~20Hz video frame
%      - Flag frames with >20ms temporal mismatch for interpolation
%      - Extract tracking coordinates for mapped frames
%      - Interpolate NaN gaps linearly
%      - Correct outliers using 15-frame moving window
%   6. Concatenate all trials into single continuous dataset
%
% Quality Control:
%   - Reports percentage of points filtered outside arena (<20% expected)
%   - Reports percentage of frames with poor alignment (<5% expected)
%   - Generates before/after correction plots for each trial
%
% Purpose:
%   Produces frame-by-frame aligned behavioral and neural activity data
%   ready for downstream analysis (place cells, behavior decoding, etc.)
% =========================================================================

fprintf('-----------------------------------------------------\n');
fprintf('STAGE 5: Synchronizing Behavior and Imaging\n');
fprintf('-----------------------------------------------------\n');

% Check if already synchronized
corrected_file = fullfile(data_path, 'Matt_files', 'correctedTrackingData.mat');
if exist(corrected_file, 'file')
    fprintf('Synchronized data already exists. Skipping...\n');
    
    % Load and display summary
    load(corrected_file, 'x_CORRECTED_ALL', 'y_CORRECTED_ALL');
    imaging_file = fullfile(data_path, 'Matt_files', 'tc_all_brain_areas_CORRECTED_ALL.mat');
    if exist(imaging_file, 'file')
        load(imaging_file, 'tc_all_brain_areas_CORRECTED_ALL');
        fprintf('  ✓ Loaded synchronized data:\n');
        fprintf('    - Behavioral: %d frames\n', length(x_CORRECTED_ALL));
        fprintf('    - Imaging: %d ROIs × %d frames\n', ...
                size(tc_all_brain_areas_CORRECTED_ALL, 1), ...
                size(tc_all_brain_areas_CORRECTED_ALL, 2));
    end
else
    fprintf('Loading DLC tracking CSV...\n');
    fprintf('Filtering arena boundaries...\n');
    fprintf('Creating temporal alignment map...\n');
    fprintf('Processing trials:\n');
    
    synchronize_behavior_imaging(data_path);
    
    fprintf('✓ Synchronization complete\n');
    
    % Display summary
    load(corrected_file, 'x_CORRECTED_ALL', 'y_CORRECTED_ALL');
    imaging_file = fullfile(data_path, 'Matt_files', 'tc_all_brain_areas_CORRECTED_ALL.mat');
    load(imaging_file, 'tc_all_brain_areas_CORRECTED_ALL');
    
    fprintf('\nSynchronized Data Summary:\n');
    fprintf('  - Total frames: %d\n', length(x_CORRECTED_ALL));
    fprintf('  - Imaging ROIs: %d\n', size(tc_all_brain_areas_CORRECTED_ALL, 1));
    fprintf('  - Valid position data: %.1f%%\n', ...
            100 * sum(~isnan(x_CORRECTED_ALL)) / length(x_CORRECTED_ALL));
end

fprintf('\n');

%% Pipeline Complete
fprintf('=====================================================\n');
fprintf('           PIPELINE COMPLETE                        \n');
fprintf('=====================================================\n');
fprintf('\n');
fprintf('Output files saved to: %s\n', fullfile(data_path, 'Matt_files'));
fprintf('\n');
fprintf('Key output files:\n');
fprintf('  • correctedTrackingData.mat\n');
fprintf('      - x_CORRECTED_ALL: 1×N X coordinates (pixels)\n');
fprintf('      - y_CORRECTED_ALL: 1×N Y coordinates (pixels)\n');
fprintf('\n');
fprintf('  • tc_all_brain_areas_CORRECTED_ALL.mat\n');
fprintf('      - Imaging data: M ROIs × N frames\n');
fprintf('\n');
fprintf('  • vec_for_vid_new.mat\n');
fprintf('      - Frame alignment indices\n');
fprintf('\n');
fprintf('  • trials_start.mat\n');
fprintf('      - Trial start frame indices\n');
fprintf('\n');
fprintf('Data is now ready for downstream analysis:\n');
fprintf('  - Place field analysis\n');
fprintf('  - Neural-behavioral correlations\n');
fprintf('  - Trajectory decoding\n');
fprintf('  - Context discrimination analysis\n');
fprintf('\n');
fprintf('=====================================================\n');
fprintf('\n');

%% Optional: Generate Summary Report
if params.show_plots
    fprintf('Generating summary visualizations...\n');
    
    % Load final data
    load(corrected_file, 'x_CORRECTED_ALL', 'y_CORRECTED_ALL');
    load(fullfile(data_path, 'arenaPolygon.mat'), 'arena_polygon');
    load(fullfile(data_path, 'background_frame.mat'), 'background_frame');
    
    % Create summary figure
    figure('Name', 'Pipeline Summary', 'Position', [100, 100, 1400, 500]);
    
    % Background frame with arena boundary
    subplot(1, 3, 1);
    imagesc(background_frame);
    axis image;
    hold on;
    if isobject(arena_polygon)
        plot([arena_polygon.Position(:, 1); arena_polygon.Position(1, 1)], ...
             [arena_polygon.Position(:, 2); arena_polygon.Position(1, 2)], ...
             'r-', 'LineWidth', 2);
    end
    title('Arena Definition', 'FontSize', 12, 'FontWeight', 'bold');
    xlabel('X (pixels)');
    ylabel('Y (pixels)');
    
    % Complete trajectory
    subplot(1, 3, 2);
    plot(x_CORRECTED_ALL, y_CORRECTED_ALL, 'b-', 'LineWidth', 0.5);
    axis equal;
    grid on;
    title('Complete Trajectory', 'FontSize', 12, 'FontWeight', 'bold');
    xlabel('X Position (pixels)');
    ylabel('Y Position (pixels)');
    
    % Data quality metrics
    subplot(1, 3, 3);
    valid_pct = 100 * sum(~isnan(x_CORRECTED_ALL)) / length(x_CORRECTED_ALL);
    
    metrics = [valid_pct, 100 - valid_pct];
    bar(metrics);
    set(gca, 'XTickLabel', {'Valid', 'Missing'});
    ylabel('Percentage (%)');
    title('Data Quality', 'FontSize', 12, 'FontWeight', 'bold');
    ylim([0, 100]);
    grid on;
    
    fprintf('✓ Summary visualizations generated\n\n');
end

fprintf('Pipeline execution complete. Thank you!\n');
fprintf('\n');
